<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MediaSegregator"
        x:Class="MediaSegregator.MainWindow"
        x:DataType="local:MainWindow"
        Title="Segregator mediów"
        Width="720" Height="380"
        MinWidth="560" MinHeight="320">

  <DockPanel Margin="12">

    <!-- Folder bar -->
    <Grid DockPanel.Dock="Top"
          ColumnDefinitions="Auto,*,Auto"
          RowDefinitions="Auto,Auto,Auto"
          Margin="0,0,0,10"
          RowSpacing="6"
          ColumnSpacing="8">

      <TextBlock Grid.Row="0" Grid.Column="0"
                 Text="Folder z mediami"
                 VerticalAlignment="Center" />
      <TextBox Grid.Row="0" Grid.Column="1"
               Text="{Binding SourceFolder}"
               KeyDown="OnSourceKeyDown"
               VerticalAlignment="Center" />
      <Button Grid.Row="0" Grid.Column="2"
              Content="Wybierz…"
              Click="OnBrowseSourceClick" />

      <TextBlock Grid.Row="1" Grid.Column="0"
                 Text="Folder docelowy"
                 VerticalAlignment="Center" />
      <TextBox Grid.Row="1" Grid.Column="1"
               Text="{Binding DestinationFolder}"
               VerticalAlignment="Center" />
      <Button Grid.Row="1" Grid.Column="2"
              Content="Wybierz…"
              Click="OnBrowseDestinationClick" />

      <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                  Orientation="Horizontal"
                  Spacing="8"
                  HorizontalAlignment="Right">
        <Button Content="Odśwież"
                Click="OnRescanClick"
                IsEnabled="{Binding !IsBusy}" />
        <Button Content="Przenieś"
                Click="OnMoveClick"
                IsDefault="True"
                IsEnabled="{Binding !IsBusy}" />
      </StackPanel>
    </Grid>

    <!-- Status bar -->
    <TextBlock DockPanel.Dock="Bottom"
               Margin="2,10,2,0"
               Opacity="0.7"
               Text="{Binding Status}" />

    <!-- What the source folder holds, at its top level only -->
    <Border BorderThickness="1"
            CornerRadius="4"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            Padding="24">
      <Grid ColumnDefinitions="*,*" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Center">
          <TextBlock Text="{Binding PhotoCount}"
                     FontSize="44"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Zdjęcia"
                     Opacity="0.7"
                     HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center">
          <TextBlock Text="{Binding VideoCount}"
                     FontSize="44"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Filmy"
                     Opacity="0.7"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

  </DockPanel>
</Window>
