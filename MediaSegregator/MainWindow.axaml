<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MediaSegregator"
        x:Class="MediaSegregator.MainWindow"
        x:DataType="local:MainWindow"
        Title="Media Segregator"
        Width="900" Height="600"
        MinWidth="560" MinHeight="320">

  <DockPanel Margin="12">

    <!-- Folder bar -->
    <Grid DockPanel.Dock="Top"
          ColumnDefinitions="Auto,*,Auto"
          RowDefinitions="Auto,Auto,Auto"
          Margin="0,0,0,10"
          RowSpacing="6"
          ColumnSpacing="8">

      <TextBlock Grid.Row="0" Grid.Column="0"
                 Text="Folder z mediami"
                 VerticalAlignment="Center" />
      <TextBox Grid.Row="0" Grid.Column="1"
               Text="{Binding SourceFolder}"
               KeyDown="OnSourceKeyDown"
               VerticalAlignment="Center" />
      <Button Grid.Row="0" Grid.Column="2"
              Content="Wybierz…"
              Click="OnBrowseSourceClick" />

      <TextBlock Grid.Row="1" Grid.Column="0"
                 Text="Folder docelowy"
                 VerticalAlignment="Center" />
      <TextBox Grid.Row="1" Grid.Column="1"
               Text="{Binding DestinationFolder}"
               VerticalAlignment="Center" />
      <Button Grid.Row="1" Grid.Column="2"
              Content="Wybierz…"
              Click="OnBrowseDestinationClick" />

      <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                  Orientation="Horizontal"
                  Spacing="8"
                  HorizontalAlignment="Right">
        <CheckBox Content="Subfolders"
                  IsChecked="{Binding Recurse}"
                  VerticalAlignment="Center" />
        <Button Content="Rescan"
                Click="OnRescanClick"
                IsEnabled="{Binding !IsBusy}" />
        <Button Content="Przenieś"
                Click="OnMoveClick"
                IsDefault="True"
                IsEnabled="{Binding !IsBusy}" />
      </StackPanel>
    </Grid>

    <!-- Status bar -->
    <TextBlock DockPanel.Dock="Bottom"
               Margin="2,10,2,0"
               Opacity="0.7"
               Text="{Binding Status}" />

    <!-- File list -->
    <!-- Column bindings resolve against ScannedFile, not this window, so they
         use reflection rather than the project-wide compiled bindings. -->
    <DataGrid ItemsSource="{Binding Files}"
              x:CompileBindings="False"
              IsReadOnly="True"
              CanUserSortColumns="True"
              GridLinesVisibility="Horizontal"
              BorderThickness="1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name"
                            Binding="{Binding Name}"
                            Width="*" />
        <DataGridTextColumn Header="Size"
                            Binding="{Binding SizeDisplay}"
                            Width="110" />
        <DataGridTextColumn Header="Modified"
                            Binding="{Binding Modified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                            Width="160" />
      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</Window>
